# 复制为 .env 后填写真实值（.env 不会被提交）
# 华为云 IoTDA 实例接入信息
AMQP_HOST=xxxxx.st1.iotda-app.cn-north-4.myhuaweicloud.com
AMQP_PORT=5671

# IoTDA 应用侧「接入凭证」中的 AccessKey / AccessCode
AMQP_ACCESS_KEY=your_access_key
AMQP_ACCESS_CODE=your_access_code

# 订阅队列名，与控制台 AMQP 订阅一致
AMQP_QUEUE=DefaultQueue

# 标准版同 Region 多实例时才需要
AMQP_INSTANCE_ID=

# 选填：默认使用项目根目录的 data/iot.db，一般无需设置
# SQLITE_PATH=C:/path/to/iot.db
